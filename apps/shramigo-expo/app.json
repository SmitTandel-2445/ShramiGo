{
  "expo": {
    "name": "ShramiGo",
    "slug": "shramigo-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shramigo",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shramigo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShramiGo needs your location to find nearby workers.",
        "NSLocationAlwaysUsageDescription": "ShramiGo needs your location to find nearby workers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#087F7A"
      },
      "package": "com.shramigo.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ShramiGo needs your location to find workers near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#087F7A",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ShramiGo needs access to your photos to set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
